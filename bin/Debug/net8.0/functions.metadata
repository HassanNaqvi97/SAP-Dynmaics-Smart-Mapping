[
  {
    "name": "SapAccountMappingFunction",
    "scriptFile": "SAP.Dynamics.SmartMapping.dll",
    "entryPoint": "Functions.SapAccountMappingFunction.RunAsync",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "message",
        "direction": "In",
        "type": "serviceBusTrigger",
        "dataType": "String",
        "queueName": "%ServiceBus__SapAccountQueueName%",
        "connection": "ServiceBusConnection",
        "cardinality": "One",
        "properties": {}
      }
    ]
  },
  {
    "name": "SapAccountMappingHttp",
    "scriptFile": "SAP.Dynamics.SmartMapping.dll",
    "entryPoint": "Functions.SapAccountMappingFunction.RunHttpAsync",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "request",
        "direction": "In",
        "type": "httpTrigger",
        "authLevel": "Function",
        "methods": [
          "post"
        ],
        "properties": {}
      },
      {
        "name": "$return",
        "type": "http",
        "direction": "Out"
      }
    ]
  }
]